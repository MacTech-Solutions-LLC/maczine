{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "maczine",
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "http": {
      "enable": true,
      "domains": [
        "www.mactechsolutionsllc.com",
        "mactechsolutionsllc.com"
      ]
    },
    "redis": true,
    "reddit": true
  },
  "scheduler": {
    "tasks": {
      "post-latest-issue": {
        "endpoint": "/internal/scheduler/post-latest-issue",
        "cron": "5,35 15-17 * * 1-5"
      },
      "weekly-thread": {
        "endpoint": "/internal/scheduler/weekly-thread",
        "cron": "5 16 * * 1"
      }
    }
  },
  "menu": {
    "items": [
      {
        "label": "Post the latest MacZine issue",
        "description": "Check the MacZine feed and post today's issue if it is not already here",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-latest-issue"
      },
      {
        "label": "Post the weekly discussion thread",
        "description": "Post this week's open thread now, if it is not already up",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/weekly-thread"
      }
    ]
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "settings": {
    "subreddit": {
      "feedUrl": {
        "type": "string",
        "label": "MacZine RSS feed URL",
        "helpText": "The feed the app reads each weekday morning. Must be https.",
        "defaultValue": "https://www.mactechsolutionsllc.com/maczine/feed.xml"
      },
      "flairId": {
        "type": "string",
        "label": "Post flair template ID (optional)",
        "helpText": "Leave blank for no flair."
      },
      "dryRun": {
        "type": "boolean",
        "label": "Dry run",
        "helpText": "When on, the app checks the feed and logs what it would post, but posts nothing.",
        "defaultValue": false
      },
      "weeklyThread": {
        "type": "boolean",
        "label": "Post a weekly discussion thread",
        "helpText": "Posts one open thread each Monday morning and pins it.",
        "defaultValue": true
      }
    }
  },
  "dev": {
    "subreddit": "maczine_dev2"
  }
}
